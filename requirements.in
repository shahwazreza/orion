# Direct dependencies (human-edited). The full pinned set is requirements.txt.
# Update procedure: README -> "Updating dependencies".
numpy
scipy
sounddevice
faster-whisper
openwakeword     # installed with --no-deps: it hard-requires tflite-runtime on Linux, which we don't use
scikit-learn     # openwakeword runtime deps, listed explicitly because of --no-deps
tqdm
requests
kokoro-onnx      # default voice
piper-tts        # fast fallback voice
onnxruntime
httpx
sherpa-onnx      # speaker recognition (TitaNet embeddings)
cryptography     # AES-GCM for data at rest
keyring          # data key lives in the system keyring (Secret Service)
pyyaml
psutil
pytest
anthropic        # Claude mode (Phase 2)
sqlcipher3-wheels  # encrypted database (Phase 2)
trafilatura      # main text of web pages (Phase 2)
argon2-cffi      # wipe passphrase hash (Phase 2.5)
secretstorage    # wipe: find every Orion keyring entry (Phase 2.5)
msal             # Outlook sign-in, device code flow (Phase 3)
